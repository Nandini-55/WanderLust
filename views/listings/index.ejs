<% layout("layouts/boilerplate")%>

    <body>
        <h3>All Listings </h3>
        <!-- <form action="/listings/new" method="get" ><button style="background-color: red; color: white; padding:5px; border: none; border-radius: 10px;">Create New Listing</button></form>
 -- as navbar has this option now -->
        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 row-cols-xsm-1">
            <% for(let listing of allListing){%>
                <a href="/listings/<%=listing._id%>" class="listing-link">
                    <div class="card col listing-card">
                        <img src="<%=listing.image.url%>" class="card-img-top" alt="listing_image"
                            style="height: 20rem;">
                            <div class="card-img-overlay"></div>
                        <div class="card-body">
                            <p class="card-text">
                                <b>
                                    <%=listing.title%>
                                </b>
                                <br>
                                &#8377; <%=listing.price.toLocaleString("en-IN")%> / night
                            </p>
                        </div>
                    </div>
                </a>
                <% }%>
        </div>
    </body>